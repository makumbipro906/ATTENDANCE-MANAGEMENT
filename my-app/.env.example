DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=verify-full
DATABASE_POOL_MAX=1

# Use long random values and configure these only in the server environment.
DEVICE_WEBHOOK_TOKEN=replace-with-a-long-random-device-token
SMS_DISPATCH_TOKEN=replace-with-a-long-random-worker-token

# Yoola SMS REST API. Keep the API key server-side; never use a NEXT_PUBLIC_ prefix.
SMS_PROVIDER_URL=https://yoolasms.com/api/v1/send
SMS_PROVIDER_TOKEN=replace-with-yoola-api-key
SMS_PROVIDER_SENDER=replace-with-approved-sender-id

# Local development only: show the OTP in the browser without SMS.
# Requires NODE_ENV=development and a localhost request; never enable for production.
# OTP_DELIVERY_MODE=development
